<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>imp2_bringup</name>
  <version>0.1.0</version>
  <description>Bringup launch files and systemd units for IMP2 robot</description>
  <maintainer email="joker22pl@users.noreply.github.com">Joker</maintainer>
  <license>MIT</license>

  <exec_depend>imp2_description</exec_depend>
  <exec_depend>imp2_base</exec_depend>
  <exec_depend>imp2_micro_ros_agent</exec_depend>
  <exec_depend>imp2_perception</exec_depend>
  <exec_depend>imp2_navigation</exec_depend>
  <exec_depend>imp2_teleop</exec_depend>
  <exec_depend>imp2_diagnostics</exec_depend>
  <exec_depend>imp2_safety</exec_depend>
  <exec_depend>imp2_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
