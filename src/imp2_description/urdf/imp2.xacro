<?xml version="1.0"?>
<!-- IMP2 robot URDF (Phase 1 skeleton)
  - Generated by Joker + Gaja
  - See ADR-0008 mechanics for dimensions
  - See ADR-0006 encoders + ADR-0003 power
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="imp2">

  <!-- Constants -->
  <xacro:property name="wheel_radius" value="0.045" />  <!-- 90 mm diameter / 2 -->
  <xacro:property name="wheel_width" value="0.010" />   <!-- 10 mm -->
  <xacro:property name="chassis_radius" value="0.100" /> <!-- 200 mm diameter / 2 -->
  <xacro:property name="chassis_height" value="0.080" /> <!-- 80 mm -->
  <xacro:property name="track" value="0.180" />         <!-- 180 mm inter-wheel -->
  <xacro:property name="battery_height" value="0.025" />
  <xacro:property name="compute_height" value="0.050" />

  <!-- Base link (origin in middle of bottom layer) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}" />
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0" />
      <origin xyz="0 0 ${chassis_height/2}" />
      <inertia ixx="0.06" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.10" />
    </inertial>
  </link>

  <link name="base_footprint" />

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" />
  </joint>

  <!-- Wheels -->
  <xacro:macro name="wheel" params="prefix pos_x">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0" />
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1" />
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel" />
      <origin xyz="${pos_x} 0 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  pos_x="0" />
  <xacro:wheel prefix="right" pos_x="0" />

  <!-- ZED2i camera (front, 30mm above chassis) -->
  <link name="zed2i_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.175 0.030 0.043" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0" />
      </material>
    </visual>
  </link>

  <joint name="zed2i_joint" type="fixed">
    <parent link="base_link" />
    <child link="zed2i_camera_link" />
    <origin xyz="0.090 0 ${chassis_height + 0.030}" rpy="0 0 0" />
  </joint>

  <link name="zed2i_left_camera_frame" />
  <link name="zed2i_right_camera_frame" />
  <link name="zed2i_imu_frame" />

  <joint name="zed2i_left_joint" type="fixed">
    <parent link="zed2i_camera_link" />
    <child link="zed2i_left_camera_frame" />
    <origin xyz="0 0.060 0" rpy="0 0 0" />
  </joint>

  <joint name="zed2i_right_joint" type="fixed">
    <parent link="zed2i_camera_link" />
    <child link="zed2i_right_camera_frame" />
    <origin xyz="0 -0.060 0" rpy="0 0 0" />
  </joint>

  <joint name="zed2i_imu_joint" type="fixed">
    <parent link="zed2i_camera_link" />
    <child link="zed2i_imu_frame" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- ros2_control: micro-ROS hardware interface -->
  <ros2_control name="imp2_hw" type="system">
    <hardware>
      <plugin>micro_ros_platformio/MicroRosHardwareInterface</plugin>
      <param name="serial_port">/dev/ttyACM0</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>

</robot>
